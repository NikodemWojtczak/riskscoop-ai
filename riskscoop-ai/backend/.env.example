# RiskScoop AI - Environment Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (required - main LLM)
GOOGLE_API_KEY=your_google_api_key_here

# MotherDuck Token (required - Overture Maps database)
MOTHERDUCK_TOKEN=your_motherduck_token_here

# GloFAS API Key (required - Copernicus flood data)
GLOFAS_API_KEY=your_glofas_api_key_here

# Mapbox Token (required - map visualization)
MAPBOX_TOKEN=your_mapbox_token_here

# Optional: Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Mock mode (set to false for production with real APIs)
MOCK_DATA=false

# Server configuration
HOST=0.0.0.0
PORT=7777
DEBUG=true

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# Logging
LOG_LEVEL=INFO
